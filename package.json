{
  "name": "synapse-mindmap",
  "version": "1.4.0",
  "description": "MCP server + live viewer: a real-time mindmap of what your coding agent is planning, thinking, and changing.",
  "type": "module",
  "license": "MIT",
  "author": "Vikas",
  "homepage": "https://vss96.github.io/synapse/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vss96/synapse.git"
  },
  "bugs": "https://github.com/vss96/synapse/issues",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mindmap",
    "coding-agent",
    "claude",
    "cursor",
    "codex",
    "opencode"
  ],
  "bin": {
    "synapse-mindmap": "dist/cli.js",
    "synapse": "dist/cli.js"
  },
  "files": [
    "dist",
    "viewer/index.html",
    "docs/public/logo.png",
    "docs/public/favicon.png"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc && tsc -p viewer && npm run build:web",
    "build:web": "esbuild viewer/app.ts --bundle --format=esm --platform=browser --outdir=dist/web --log-level=warning",
    "build:watch": "tsc --watch",
    "prepack": "npm run build",
    "start": "node dist/index.js",
    "dev": "bun --watch src/index.ts",
    "viewer": "bun run build && SYNAPSE_DATA_DIR=./data node dist/cli.js viewer",
    "test": "tsc -p tests && npm run build:web && bun test",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "typecheck": "tsc --noEmit -p . && tsc -p viewer && tsc -p tests"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.7.0",
    "nanoid": "^5.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.0",
    "vitepress": "^1.6.4"
  }
}
