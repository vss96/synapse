{
  "name": "synapse",
  "version": "1.0.0",
  "description": "Synapse – MCP mindmap server. Any agent can create, navigate, and visualize structured thoughts.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "start": "node dist/index.js",
    "dev": "bun --watch src/index.ts",
    "viewer": "bun viewer/server.js",
    "test": "bun test",
    "all": "bun run build && (bun run start & bun run viewer)"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.7.0",
    "nanoid": "^5.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}